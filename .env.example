# ========================================================
# WebPoster Production Environment Configuration (.env)
# ========================================================

# Server Port
PORT=8080

# --------------------------------------------------------
# Neon PostgreSQL Configuration
# --------------------------------------------------------
# Format: jdbc:postgresql://<NEON_HOST>/<DB_NAME>?sslmode=require
# Example: jdbc:postgresql://ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://ep-your-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=your_neon_username
DB_PASS=your_neon_password

# Database pool and migration settings
DB_POOL_MAX=10
DB_POOL_MIN=2
JPA_DDL_AUTO=update
SHOW_SQL=false

# --------------------------------------------------------
# JWT Configuration
# --------------------------------------------------------
# Secret key must be at least 256 bits long (32+ chars)
JWT_SECRET=your_super_secret_production_key_must_be_long_and_secure_32_chars!
# Refresh token validity: 7 days in milliseconds (604800000)
JWT_REFRESH_TIME=604800000
# Access token validity: 15 minutes in milliseconds (900000)
JWT_ACCESS_TIME=900000

# --------------------------------------------------------
# Security & CORS
# --------------------------------------------------------
# Set to true if deploying over HTTPS (SSL), false for HTTP
COOKIE_SECURE=false
# SameSite attribute for refresh token cookie (Lax for same-domain/docker, None for cross-origin HTTPS)
COOKIE_SAME_SITE=Lax

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
